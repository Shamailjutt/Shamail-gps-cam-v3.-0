<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_bg"
    android:orientation="vertical">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/navy_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/btnBackMapPicker"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/gold_bright" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Select GPS Location"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveBookmarkFromMap"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Save Location"
            android:textColor="@color/gold_bright"
            android:textSize="11sp"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_bookmark"
            app:iconSize="15dp"
            app:iconTint="@color/gold_bright"
            app:strokeColor="@color/gold_primary" />
    </LinearLayout>

    <!-- Place / Address Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingBottom="10dp">

        <EditText
            android:id="@+id/etMapSearch"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@color/navy_bg"
            android:hint="Search city, street, or landmark..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMapSearch"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Search"
            android:textColor="@color/gold_on_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@color/gold_primary"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_search"
            app:iconSize="16dp"
            app:iconTint="@color/gold_on_primary" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Interactive Google Map Container (visible when MAPS_API_KEY is configured) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMapWrapper"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                app:cardBackgroundColor="@color/navy_deep"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/gold_primary"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:id="@+id/mapContainerFrame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Clear Notice shown ONLY when BuildConfig.MAPS_API_KEY is blank -->
            <LinearLayout
                android:id="@+id/cardMapsKeyNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_navy"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Google Maps SDK API Key Not Configured"
                    android:textColor="@color/gold_bright"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="To enable interactive Google Map tiles in the APK, add MAPS_API_KEY to GitHub Repository Secrets (or android-project/local.properties). Place search and coordinate selection below work immediately using Android Geocoder."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Selected Coordinates & Address Editor -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_navy"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvMapTapHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tap anywhere on the map to move the gold GPS pin, or refine details below:"
                    android:textColor="@color/gold_bright"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Location Title (City, District, Province)"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etSelectedLocationTitle"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/navy_bg"
                    android:hint="e.g. Lahore, Punjab, Pakistan"
                    android:inputType="textCapWords"
                    android:paddingHorizontal="10dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Full Street / Area Address"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etSelectedFullAddress"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/navy_bg"
                    android:hint="Full street or area address"
                    android:inputType="textCapSentences"
                    android:paddingHorizontal="10dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etSelectedLat"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@color/navy_bg"
                        android:hint="Latitude"
                        android:inputType="numberDecimal|numberSigned"
                        android:paddingHorizontal="10dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etSelectedLon"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@color/navy_bg"
                        android:hint="Longitude"
                        android:inputType="numberDecimal|numberSigned"
                        android:paddingHorizontal="10dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLookupTypedCoords"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:text="Resolve Address from Coordinates"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    app:backgroundTint="@color/navy_surface"
                    app:cornerRadius="8dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Confirm Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy_surface"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmMapLocation"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Confirm Selected Location"
            android:textColor="@color/gold_on_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/gold_primary"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_map_pin"
            app:iconGravity="textStart"
            app:iconTint="@color/gold_on_primary" />
    </LinearLayout>

</LinearLayout>
