# GEMINI_API_KEY: Optional server-side key injected by AI Studio runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform JavaScript & Places API key for the interactive Web Studio.
VITE_GOOGLE_MAPS_API_KEY=""

# MAPS_API_KEY: Optional Google Maps SDK for Android API key for native Android APK builds (GitHub Secrets / local.properties).
MAPS_API_KEY=""
